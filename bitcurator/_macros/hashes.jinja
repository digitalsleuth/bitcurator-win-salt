{% macro get_hash(name, part=None) -%}
  {%- set entry = hashes.get(name) -%}
  {%- if entry is none -%}{{- salt['test.exception']('hashes.jinja: no entry for "' ~ name ~ '"') -}}{%- endif -%}
  {%- if entry is mapping -%}
    {%- set part = part if part is not none else 'hash' -%}
    {%- if part not in entry -%}{{- salt['test.exception']('hashes.jinja: ' ~ name ~ ' has no "' ~ part ~ '" (has: ' ~ entry.keys() | list | join(', ') ~ ')') -}}{%- endif -%}
    {%- set entry = entry[part] -%}
  {%- elif part is not none -%}
    {{- salt['test.exception']('hashes.jinja: ' ~ name ~ ' has a single hash, not "' ~ part ~ '"') -}}
  {%- endif -%}
  {{- entry -}}
{%- endmacro %}
